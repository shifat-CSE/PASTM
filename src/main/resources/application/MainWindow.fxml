<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="application.MainWindowController"
            styleClass="root">

    <!-- TOP HEADER -->
    <top>
        <HBox styleClass="header-bar" alignment="CENTER_LEFT" spacing="12">
            <StackPane styleClass="logo-badge">
                <SVGPath styleClass="logo-icon"
                         content="M12,2.5 C10.07,2.5 8.5,4.07 8.5,6 C8.5,7.93 10.07,9.5 12,9.5 C13.93,9.5 15.5,7.93 15.5,6 C15.5,4.07 13.93,2.5 12,2.5 Z M12,21.5 C7.5,17.5 5,14.5 5,11.5 C5,9 7,7 9.5,7 C10.32,7 11,7.4 12,8.5 C13,7.4 13.68,7 14.5,7 C17,7 19,9 19,11.5 C19,14.5 16.5,17.5 12,21.5 Z"/>
            </StackPane>
            <Label text="PASTM" styleClass="logo-title"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="[Light]" onAction="#onLightModeToggle" styleClass="header-link"/>
            <Label text="|" styleClass="header-sep"/>
            <Label fx:id="dateLabel" text="[Date: --]" styleClass="header-link"/>
            <Label text="|" styleClass="header-sep"/>
            <Button text="[User]" onAction="#onUserClicked" styleClass="header-link"/>
        </HBox>
    </top>

    <!-- CENTER -->
    <center>
        <VBox>
            <!-- Tab bar -->
            <HBox styleClass="tab-bar" alignment="CENTER_LEFT" spacing="8">
                <Button fx:id="tabScreen" text="SCREEN TIME" onAction="#onTabScreen"
                        styleClass="tab-button, tab-active"/>
                <Label text="|" styleClass="tab-sep"/>
                <Button fx:id="tabStudy" text="STUDY TIME" onAction="#onTabStudy"
                        styleClass="tab-button"/>
                <Label text="|" styleClass="tab-sep"/>
                <Button fx:id="tabSleep" text="SLEEP TIME" onAction="#onTabSleep"
                        styleClass="tab-button"/>
                <Label text="|" styleClass="tab-sep"/>
                <Button fx:id="tabJournal" text="JOURNAL" onAction="#onTabJournal"
                        styleClass="tab-button"/>
            </HBox>

            <!-- Main content -->
            <HBox spacing="15" styleClass="content-area">
                <VBox spacing="15" HBox.hgrow="ALWAYS">
                    <VBox styleClass="session-panel" spacing="12">
                        <Label text="▌ NEW SESSION" styleClass="section-heading"/>
                        <Label text="&gt; SELECT ACTIVITY" styleClass="sub-label"/>
                        <FlowPane fx:id="activityChipBox" hgap="10" vgap="10" prefWrapLength="720"/>
                        <Label text="&gt; OR TYPE CUSTOM" styleClass="sub-label"/>
                        <TextField fx:id="activityField" promptText="custom activity name..."
                                   styleClass="underline-input"/>
                        <Label text="&gt; MOOD (before session)" styleClass="sub-label"/>
                        <HBox spacing="18" alignment="CENTER_LEFT">
                            <HBox fx:id="moodBox" spacing="18" alignment="CENTER_LEFT"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Label fx:id="timerLabel" text="00:00:00" styleClass="timer-label"/>
                            <Button fx:id="startBtn" text="▶ START SESSION"
                                    onAction="#onStartSession" styleClass="start-button"/>
                        </HBox>
                    </VBox>

                    <VBox VBox.vgrow="ALWAYS" styleClass="table-panel" spacing="10">
                        <Label text="▌ TODAY'S ACTIVITY" styleClass="section-heading"/>
                        <TableView fx:id="sessionTable" VBox.vgrow="ALWAYS"
                                   styleClass="session-table">
                            <columns>
                                <TableColumn fx:id="colActivity" text="ACTIVITY" prefWidth="240"/>
                                <TableColumn fx:id="colCategory" text="CATEGORY" prefWidth="150"/>
                                <TableColumn fx:id="colDuration" text="DURATION" prefWidth="130"/>
                                <TableColumn fx:id="colRating" text="RATING" prefWidth="160"/>
                                <TableColumn fx:id="colMood" text="MOOD" prefWidth="100"/>
                            </columns>
                        </TableView>
                    </VBox>
                </VBox>

                <VBox spacing="15" prefWidth="340" styleClass="right-panel">
                    <VBox styleClass="chart-panel" spacing="8">
                        <Label text="▌ TIME OF DAY" styleClass="section-heading"/>
                        <BarChart fx:id="timeOfDayChart" prefHeight="180">
                            <xAxis><CategoryAxis/></xAxis>
                            <yAxis><NumberAxis/></yAxis>
                        </BarChart>
                    </VBox>

                    <VBox styleClass="tip-panel" spacing="10">
                        <Label text="▌ DAILY TIP" styleClass="section-heading"/>
                        <Label fx:id="tipLabel"
                               text="&quot;Discipline equals freedom.&quot;"
                               wrapText="true"
                               styleClass="tip-quote"/>
                        <Label text="— JOCKO WILLINK" styleClass="tip-attribution"/>
                        <Region prefHeight="5"/>
                        <Button text="[refresh]" onAction="#onRefreshTip" styleClass="link-button"/>
                    </VBox>

                    <VBox styleClass="streak-panel" spacing="5" alignment="CENTER_LEFT">
                        <Label text="▌ DAY STREAK" styleClass="section-heading"/>
                        <Label text="07" styleClass="streak-number"/>
                        <Label text="keep going" styleClass="streak-subtitle"/>
                    </VBox>
                </VBox>
            </HBox>
        </VBox>
    </center>

    <!-- BOTTOM STATUS BAR -->
    <bottom>
        <HBox styleClass="status-bar" alignment="CENTER_LEFT" spacing="14">
            <Label fx:id="statusLabel" text="● READY" styleClass="status-ready"/>
            <Label text="|" styleClass="status-sep"/>
            <Label text="7-day streak" styleClass="status-text"/>
            <Label text="|" styleClass="status-sep"/>
            <Label text="4.2 avg rating" styleClass="status-text"/>
            <Label text="|" styleClass="status-sep"/>
            <Label text="4h 12m today" styleClass="status-text"/>
            <Label text="|" styleClass="status-sep"/>
            <Label text="12 sessions" styleClass="status-text"/>
            <Label text="|" styleClass="status-sep"/>
            <Label text="all data local" styleClass="status-text"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label text="[build 2.0.1]" styleClass="status-build"/>
        </HBox>
    </bottom>
</BorderPane>