<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.chart.PieChart?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.SVGPath?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="application.MainWindowController"
            styleClass="root">

    <top>
        <HBox styleClass="header-bar" alignment="CENTER_LEFT" spacing="12">
            <StackPane styleClass="logo-badge">
                <SVGPath styleClass="logo-icon"
                         content="M12,2.5 C10.07,2.5 8.5,4.07 8.5,6 C8.5,7.93 10.07,9.5 12,9.5 C13.93,9.5 15.5,7.93 15.5,6 C15.5,4.07 13.93,2.5 12,2.5 Z M12,21.5 C7.5,17.5 5,14.5 5,11.5 C5,9 7,7 9.5,7 C10.32,7 11,7.4 12,8.5 C13,7.4 13.68,7 14.5,7 C17,7 19,9 19,11.5 C19,14.5 16.5,17.5 12,21.5 Z"/>
            </StackPane>
            <Label text="PASTM" styleClass="logo-title"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="themeToggleBtn" text="[Light]" onAction="#onLightModeToggle" styleClass="header-link"/>
            <Label text="|" styleClass="header-sep"/>
            <Button fx:id="exportBtn" text="[Export]" onAction="#onExport" styleClass="header-link"/>
            <Label text="|" styleClass="header-sep"/>
            <Label fx:id="clockLabel" text="[--:--:--]" styleClass="header-link"/>
            <Label text="|" styleClass="header-sep"/>
            <Button fx:id="userBtn" text="[User]" onAction="#onUserClicked" styleClass="header-link"/>
        </HBox>
    </top>

    <center>
        <VBox>
            <HBox styleClass="tab-bar" alignment="CENTER_LEFT" spacing="8">
                <Button fx:id="tabScreen" text="SCREEN TIME" onAction="#onTabScreen"
                        styleClass="tab-button, tab-active"/>
                <Label text="|" styleClass="tab-sep"/>
                <Button fx:id="tabStudy" text="STUDY TIME" onAction="#onTabStudy" styleClass="tab-button"/>
                <Label text="|" styleClass="tab-sep"/>
                <Button fx:id="tabSleep" text="SLEEP TIME" onAction="#onTabSleep" styleClass="tab-button"/>
                <Label text="|" styleClass="tab-sep"/>
                <Button fx:id="tabJournal" text="JOURNAL" onAction="#onTabJournal" styleClass="tab-button"/>
            </HBox>

            <HBox spacing="15" styleClass="content-area">
                <VBox spacing="15" HBox.hgrow="ALWAYS">

                    <VBox fx:id="mainPanel" spacing="15" VBox.vgrow="ALWAYS">

                        <VBox fx:id="sessionPanel" styleClass="session-panel" spacing="12">
                            <Label text="▌ NEW SESSION" styleClass="section-heading"/>
                            <Label text="&gt; SELECT ACTIVITY" styleClass="sub-label"/>
                            <FlowPane fx:id="activityChipBox" hgap="10" vgap="10" prefWrapLength="720"/>
                            <Label text="&gt; OR TYPE CUSTOM" styleClass="sub-label"/>
                            <TextField fx:id="activityField" promptText="custom activity name..."
                                       styleClass="underline-input"/>
                            <Label text="&gt; MOOD (before session)" styleClass="sub-label"/>
                            <HBox spacing="18" alignment="CENTER_LEFT">
                                <HBox fx:id="moodBox" spacing="18" alignment="CENTER_LEFT"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Label fx:id="timerLabel" text="00:00:00" styleClass="timer-label"/>
                                <Button fx:id="pauseBtn" text="⏸ PAUSE" visible="false" managed="false"
                                        onAction="#onPauseResume" styleClass="pause-button"/>
                                <Button fx:id="startBtn" text="▶ START SESSION"
                                        onAction="#onStartSession" styleClass="start-button"/>
                            </HBox>
                        </VBox>

                        <VBox fx:id="sleepPanel" visible="false" managed="false"
                              styleClass="session-panel" spacing="14">
                            <Label text="▌ SLEEP LOG — MANUAL ENTRY" styleClass="section-heading"/>
                            <Label text="Enter how long you slept. You can edit this anytime."
                                   styleClass="sub-label"/>
                            <HBox spacing="20" alignment="CENTER_LEFT">
                                <Label text="Hours:" styleClass="sub-label"/>
                                <TextField fx:id="sleepHoursField" promptText="7"
                                           prefWidth="80" styleClass="underline-input"/>
                                <Label text="Minutes:" styleClass="sub-label"/>
                                <TextField fx:id="sleepMinutesField" promptText="0"
                                           prefWidth="80" styleClass="underline-input"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Button fx:id="sleepClearBtn" text="✕ Clear"
                                        onAction="#onClearSleep" styleClass="pause-button"/>
                                <Button fx:id="sleepSaveBtn" text="💾  Save Sleep"
                                        onAction="#onSaveSleep" styleClass="start-button"/>
                            </HBox>
                            <Region prefHeight="4"/>
                            <HBox spacing="10" alignment="CENTER_LEFT">
                                <Label text="Today:" styleClass="sub-label"/>
                                <Label fx:id="sleepTodayLabel" text="No sleep logged for today"
                                       styleClass="sleep-status"/>
                            </HBox>

                            <Separator/>
                            <Label text="▌ POWER NAP TIMER" styleClass="section-heading"/>
                            <Label text="Set a short nap duration. You'll be notified when time is up."
                                   styleClass="sub-label"/>

                            <HBox spacing="15" alignment="CENTER_LEFT">
                                <Label text="Duration (minutes):" styleClass="sub-label"/>
                                <TextField fx:id="napMinutesField" promptText="20"
                                           prefWidth="80" styleClass="underline-input"/>
                                <Region prefWidth="10"/>
                                <Label fx:id="napCountdownLabel" text="--:--"
                                       styleClass="nap-countdown"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Button fx:id="napCancelBtn" text="✕ Cancel"
                                        onAction="#onCancelNap" styleClass="pause-button"
                                        visible="false" managed="false"/>
                                <Button fx:id="napStartBtn" text="😴  Start Nap"
                                        onAction="#onStartNap" styleClass="start-button"/>
                            </HBox>

                            <Separator/>
                            <Label text="▌ SLEEP HISTORY (LAST 14 DAYS)" styleClass="section-heading"/>
                            <ListView fx:id="sleepHistoryList" prefHeight="180"
                                      styleClass="sleep-history-list"/>
                        </VBox>

                        <VBox VBox.vgrow="ALWAYS" styleClass="table-panel" spacing="10">
                            <HBox spacing="12" alignment="CENTER_LEFT">
                                <Label text="▌ TODAY'S ACTIVITY" styleClass="section-heading"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <CheckBox fx:id="favoritesFilter" text="Favorites only"
                                          styleClass="favorites-filter"/>
                                <TextField fx:id="searchField" promptText="search..." prefWidth="160"
                                           styleClass="search-field"/>
                            </HBox>
                            <TableView fx:id="sessionTable" VBox.vgrow="ALWAYS" styleClass="session-table">
                                <columns>
                                    <TableColumn fx:id="colFavorite" text="★" prefWidth="50"/>
                                    <TableColumn fx:id="colActivity" text="ACTIVITY" prefWidth="220"/>
                                    <TableColumn fx:id="colCategory" text="CATEGORY" prefWidth="140"/>
                                    <TableColumn fx:id="colDuration" text="DURATION" prefWidth="120"/>
                                    <TableColumn fx:id="colRating" text="RATING" prefWidth="150"/>
                                    <TableColumn fx:id="colMood" text="MOOD" prefWidth="80"/>
                                </columns>
                            </TableView>
                        </VBox>
                    </VBox>

                    <VBox fx:id="journalPanel" visible="false" managed="false"
                          spacing="12" VBox.vgrow="ALWAYS">
                        <VBox styleClass="session-panel" spacing="10">
                            <Label text="▌ DAILY WORKFLOW JOURNAL" styleClass="section-heading"/>
                            <HBox spacing="15" alignment="CENTER_LEFT">
                                <Label text="Date:" styleClass="sub-label"/>
                                <DatePicker fx:id="journalDatePicker" prefWidth="180"/>
                                <Button fx:id="prepareJournalBtn" text="📋  Prepare Journal"
                                        onAction="#onPrepareJournal" styleClass="prepare-journal-button"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Label fx:id="journalStatus" text="● " styleClass="sub-label"/>
                            </HBox>
                        </VBox>

                        <ScrollPane fitToWidth="true" styleClass="journal-scroll" VBox.vgrow="ALWAYS">
                            <VBox spacing="10">
                                <VBox styleClass="journal-slot" spacing="6">
                                    <HBox spacing="10" alignment="CENTER_LEFT">
                                        <Label text="🌅" styleClass="journal-slot-icon"/>
                                        <Label text="MORNING" styleClass="journal-slot-title"/>
                                        <Label text="06:00 — 12:00" styleClass="journal-slot-time"/>
                                    </HBox>
                                    <TextArea fx:id="journalMorning" wrapText="true"
                                              prefRowCount="3" styleClass="journal-textarea"
                                              promptText="What did you plan or do this morning? Any wins?"/>
                                </VBox>

                                <VBox styleClass="journal-slot" spacing="6">
                                    <HBox spacing="10" alignment="CENTER_LEFT">
                                        <Label text="☀" styleClass="journal-slot-icon"/>
                                        <Label text="NOON" styleClass="journal-slot-title"/>
                                        <Label text="12:00 — 14:00" styleClass="journal-slot-time"/>
                                    </HBox>
                                    <TextArea fx:id="journalNoon" wrapText="true"
                                              prefRowCount="2" styleClass="journal-textarea"
                                              promptText="Lunch break, quick tasks, anything worth noting?"/>
                                </VBox>

                                <VBox styleClass="journal-slot" spacing="6">
                                    <HBox spacing="10" alignment="CENTER_LEFT">
                                        <Label text="🌤" styleClass="journal-slot-icon"/>
                                        <Label text="AFTERNOON" styleClass="journal-slot-title"/>
                                        <Label text="14:00 — 18:00" styleClass="journal-slot-time"/>
                                    </HBox>
                                    <TextArea fx:id="journalAfternoon" wrapText="true"
                                              prefRowCount="3" styleClass="journal-textarea"
                                              promptText="Deep work? What moved forward? What got stuck?"/>
                                </VBox>

                                <VBox styleClass="journal-slot" spacing="6">
                                    <HBox spacing="10" alignment="CENTER_LEFT">
                                        <Label text="🌆" styleClass="journal-slot-icon"/>
                                        <Label text="EVENING" styleClass="journal-slot-title"/>
                                        <Label text="18:00 — 21:00" styleClass="journal-slot-time"/>
                                    </HBox>
                                    <TextArea fx:id="journalEvening" wrapText="true"
                                              prefRowCount="3" styleClass="journal-textarea"
                                              promptText="Wind-down activities, family time, exercise?"/>
                                </VBox>

                                <VBox styleClass="journal-slot" spacing="6">
                                    <HBox spacing="10" alignment="CENTER_LEFT">
                                        <Label text="🌙" styleClass="journal-slot-icon"/>
                                        <Label text="NIGHT" styleClass="journal-slot-title"/>
                                        <Label text="21:00 — 06:00" styleClass="journal-slot-time"/>
                                    </HBox>
                                    <TextArea fx:id="journalNight" wrapText="true"
                                              prefRowCount="4" styleClass="journal-textarea"
                                              promptText="Reflect on the day. What did you learn? What will you do differently?"/>
                                </VBox>
                            </VBox>
                        </ScrollPane>
                    </VBox>
                </VBox>

                <ScrollPane fitToWidth="true" styleClass="right-panel-scroll" prefWidth="380">
                    <VBox styleClass="right-panel" spacing="12">

                        <VBox fx:id="dndCard" styleClass="dnd-card" spacing="10">
                            <HBox alignment="CENTER_LEFT">
                                <Label text="▌ DO NOT DISTURB" styleClass="section-heading"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Label fx:id="dndStatusLabel" text="OFF" styleClass="dnd-status-off"/>
                            </HBox>
                            <Label text="Lock everything except Study Time."
                                   styleClass="dnd-description" wrapText="true"/>
                            <HBox spacing="10">
                                <Button fx:id="dndOnBtn" text="🔒  DND ON"
                                        onAction="#onDndOn" styleClass="dnd-on-button"
                                        maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                                <Button fx:id="dndOffBtn" text="🔓  DND OFF"
                                        onAction="#onDndOff" styleClass="dnd-off-button"
                                        maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                            </HBox>
                        </VBox>

                        <VBox styleClass="chart-panel" spacing="8">
                            <Label text="▌ SCREEN TIME BY APP" styleClass="section-heading"/>
                            <PieChart fx:id="screenTimePieChart"
                                      prefHeight="200"
                                      labelsVisible="true"
                                      legendVisible="true"
                                      startAngle="90"/>
                        </VBox>

                        <VBox styleClass="chart-panel" spacing="8">
                            <Label text="▌ LAST 7 DAYS" styleClass="section-heading"/>
                            <BarChart fx:id="weekChart" prefHeight="170" legendVisible="true"
                                      animated="false" categoryGap="8">
                                <xAxis><CategoryAxis/></xAxis>
                                <yAxis><NumberAxis/></yAxis>
                            </BarChart>
                        </VBox>

                        <VBox styleClass="goals-card" spacing="10">
                            <HBox alignment="CENTER_LEFT">
                                <Label text="▌ DAILY GOALS" styleClass="section-heading"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Button text="Edit" onAction="#onEditGoals" styleClass="link-button"/>
                            </HBox>
                            <HBox spacing="8" alignment="CENTER_LEFT">
                                <Label text="📚" styleClass="goal-icon"/>
                                <Label text="Study" styleClass="goal-name"/>
                                <ProgressBar fx:id="goalStudyBar" progress="0" prefWidth="120" styleClass="goal-progress"/>
                                <Label fx:id="goalStudyText" text="0m / 0m" styleClass="goal-text"/>
                            </HBox>
                            <HBox spacing="8" alignment="CENTER_LEFT">
                                <Label text="📱" styleClass="goal-icon"/>
                                <Label text="Screen" styleClass="goal-name"/>
                                <ProgressBar fx:id="goalScreenBar" progress="0" prefWidth="120" styleClass="goal-progress"/>
                                <Label fx:id="goalScreenText" text="0m / 0m" styleClass="goal-text"/>
                            </HBox>
                            <HBox spacing="8" alignment="CENTER_LEFT">
                                <Label text="🌙" styleClass="goal-icon"/>
                                <Label text="Sleep" styleClass="goal-name"/>
                                <ProgressBar fx:id="goalSleepBar" progress="0" prefWidth="120" styleClass="goal-progress"/>
                                <Label fx:id="goalSleepText" text="0m / 0m" styleClass="goal-text"/>
                            </HBox>
                        </VBox>

                        <VBox styleClass="tip-panel" spacing="10">
                            <Label text="▌ DAILY TIP" styleClass="section-heading"/>
                            <Label fx:id="tipLabel" text="&quot;Loading...&quot;"
                                   wrapText="true" styleClass="tip-quote"/>
                            <Label fx:id="tipAttributionLabel" text="— "
                                   styleClass="tip-attribution"/>
                            <Region prefHeight="5"/>
                            <Button text="[refresh]" onAction="#onRefreshTip" styleClass="link-button"/>
                        </VBox>

                        <VBox styleClass="streak-panel" spacing="5" alignment="CENTER_LEFT">
                            <Label text="▌ DAY STREAK" styleClass="section-heading"/>
                            <Label fx:id="streakLabel" text="00" styleClass="streak-number"/>
                            <Label text="keep going" styleClass="streak-subtitle"/>
                        </VBox>

                    </VBox>
                </ScrollPane>
            </HBox>
        </VBox>
    </center>

    <bottom>
        <HBox styleClass="status-bar" alignment="CENTER_LEFT" spacing="14">
            <Label fx:id="statusLabel" text="● READY" styleClass="status-ready"/>
            <Label fx:id="dndStatusBarLabel" text="" styleClass="status-dnd" visible="false" managed="false"/>
            <Label text="|" styleClass="status-sep"/>
            <Label text="double-click a row to edit" styleClass="status-text"/>
            <Label text="|" styleClass="status-sep"/>
            <Label text="favorite via ★" styleClass="status-text"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label text="[build 2.0.2]" styleClass="status-build"/>
        </HBox>
    </bottom>
</BorderPane>